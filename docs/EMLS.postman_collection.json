{
  "info": {
    "_postman_id": "e3c1b8a2-5d4f-4a67-9b21-0f6c7a1d2e88",
    "name": "Equipment Maintenance Log System (EMLS) API",
    "description": "REST API for the EMLS (Laravel + Sanctum).\n\n**Setup**\n1. Run the backend: `php artisan serve --port=8000`\n2. Run the **Auth > Login** request (defaults to the admin demo account). The token is saved automatically to the `token` collection variable.\n3. All other requests use Bearer authentication with `{{token}}`.\n\n**Roles**\n- Admin (Custodian): full access\n- Technician: view equipment, record logs\n- Room In-Charge: view equipment in assigned rooms\n\nLogs are append-only: they cannot be deleted, only voided with a reason.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "equipmentId",
      "value": "1"
    },
    {
      "key": "logId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Authenticate and receive a Sanctum token. Demo accounts: admin@example.com, tech@example.com, faculty@example.com (password: `password`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Revoke the current token. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Get the authenticated user's details (including role)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "List Equipment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "",
                  "disabled": true,
                  "description": "Search by equipment name or property number"
                },
                {
                  "key": "room_id",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by room ID"
                },
                {
                  "key": "status",
                  "value": "",
                  "disabled": true,
                  "description": "Working | Under Repair | Needs Replacement | Disposed"
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true,
                  "description": "Page number"
                }
              ]
            },
            "description": "List paginated equipment. All roles (Room In-Charge sees only equipment in assigned rooms)."
          },
          "response": []
        },
        {
          "name": "Get Equipment Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment/{{equipmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{equipmentId}}"
              ]
            },
            "description": "Equipment details including its maintenance timeline logs."
          },
          "response": []
        },
        {
          "name": "Create Equipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment"
              ]
            },
            "description": "Create a new equipment record. **Admin only.** (Field names are inferred; adjust to your validation rules.)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Oscilloscope\",\n  \"property_number\": \"PN-2024-0001\",\n  \"category\": \"Laboratory\",\n  \"room_id\": 1,\n  \"status\": \"Working\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete Equipment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment/{{equipmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{equipmentId}}"
              ]
            },
            "description": "**Admin only.** Equipment with prior maintenance history is preserved and marked as *Disposed* instead of being removed. (Route inferred from the safe-deletion feature.)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Maintenance Logs",
      "item": [
        {
          "name": "Record Maintenance Log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ]
            },
            "description": "Record a maintenance log entry. **Admin, Technician.** Actions: Cleaned, Repaired, Modified, Inspected, Part Replaced. (Field names are inferred.)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipment_id\": 1,\n  \"action\": \"Repaired\",\n  \"notes\": \"Replaced faulty power supply.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Void Log",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logs/{{logId}}/void",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs",
                "{{logId}}",
                "void"
              ]
            },
            "description": "Void a log entry with a stated reason. **Admin only.** The log remains in the audit trail.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Entered against the wrong equipment.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
